# Copy to .env and fill in. `python scripts/preflight.py` will tell you what's missing.

# ---------------------------------------------------------------------------
# LangSmith — required for Modules 1-4
# ---------------------------------------------------------------------------
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true

# Every participant MUST use a unique project name, or you'll all be looking at
# each other's traces in Module 3. Use your name or initials.
LANGSMITH_PROJECT=aria-workshop-YOURNAME

# Only change this if you're on a self-hosted or EU LangSmith instance.
# EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Model provider — you need at least ONE of these
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Which model the agent uses. Format is "provider:model" (init_chat_model syntax).
# Module 2 runs the same evals across all three and prints a cost/quality/latency table.
ARIA_MODEL=anthropic:claude-sonnet-5

# The expensive baseline we start from in Module 2. The exercise is: does the cheaper
# model hold quality? Start here, then try to give the money back.
ARIA_FRONTIER_MODEL=anthropic:claude-opus-5

# The cheapest candidate.
ARIA_CHEAP_MODEL=anthropic:claude-haiku-4-5-20251001

# The model that grades. Keep this FIXED across experiments — changing your judge
# mid-comparison invalidates the comparison. (Module 2 covers why.)
JUDGE_MODEL=anthropic:claude-sonnet-5

# ---------------------------------------------------------------------------
# Optional — Module 3 alert routing. Skip these and we'll use a webhook.site URL.
# ---------------------------------------------------------------------------
# PAGERDUTY_ROUTING_KEY=
# ALERT_WEBHOOK_URL=
